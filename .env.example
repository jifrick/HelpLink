APP_NAME=HelpLink
ENV=development
DEBUG=True
SECRET_KEY=change_this_to_a_secure_random_secret_in_production

# Database Connection String
# For local SQLite: sqlite:///./helplink.db
# For PostgreSQL / Supabase: postgresql://postgres:[YOUR_PASSWORD]@[YOUR_SUPABASE_HOST]:6543/postgres
DATABASE_URL=sqlite:///./helplink.db

# Admin Initial Account Setup
ADMIN_INITIAL_EMAIL=admin@helplink.org
ADMIN_INITIAL_PASSWORD=YourSecureAdminPassword123!
