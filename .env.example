APP_NAME=HelpLink
ENV=development
DEBUG=True
SECRET_KEY=change_this_to_a_secure_random_secret_in_production

# Development Auth Bypass (DEVELOPMENT ONLY)
# Set to true during local development to inspect protected routes & admin dashboard without logging in.
# WARNING: Must be false in production (application fails startup if set to true when ENV=production).
AUTH_BYPASS_ENABLED=false

# Database Connection String
# For local SQLite: sqlite:///./helplink.db
# For PostgreSQL / Supabase: postgresql://postgres:[YOUR_PASSWORD]@[YOUR_SUPABASE_HOST]:6543/postgres
DATABASE_URL=sqlite:///./helplink.db

# Admin Initial Account Setup
ADMIN_INITIAL_EMAIL=admin@helplink.org
ADMIN_INITIAL_PASSWORD=YourSecureAdminPassword123!

# Supabase Auth Configuration (Google OAuth Integration)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

